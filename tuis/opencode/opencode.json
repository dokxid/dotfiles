{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "default_router",
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "provider": {},
  "agent": {
    "plan": {
      "temperature": 0.3,
      "options": {},
      "permission": {},
      "tools": {
        "glob": true,
        "grep": true,
        "read": true,
        "webfetch": true
      }
    },
    "build": {
      "temperature": 0.1,
      "disable": true,
      "options": {},
      "permission": {}
    },
    "edit": {
      "description": "Full development agent with all tools enabled",
      "mode": "primary",
      "prompt": "You are a software engineering agent. You have full access to all tools and can read, write, edit files, and run commands. Help the user with any development task.",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "read": true,
        "webfetch": true
      },
      "options": {},
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "webfetch": "allow"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "~/.config/opencode/rules/*": "allow",
      "/tmp/*": "allow",
      "*": "allow",
      "*.env.local": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "task": "allow",
    "lsp": "allow",
    "find": "allow",
    "skill": "allow",
    "glob": "allow",
    "list": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "edit": "ask",
    "bash": "ask",
    "todowrite": "allow"
  },
}
